<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cổng Tra Cứu Lớp 10 - THPT Nguyễn Duy Trinh</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-blue-900 via-indigo-900 to-slate-900 min-h-screen flex items-center justify-center p-4">

  <div class="bg-white rounded-3xl shadow-2xl p-6 sm:p-8 max-w-md w-full text-center space-y-6 border-4 border-amber-400">
    
    <!-- Logo hoặc Biểu tượng -->
    <div class="w-20 h-20 bg-blue-100 text-blue-900 rounded-full flex items-center justify-center text-4xl mx-auto shadow-inner">
      🏫
    </div>

    <!-- Tiêu đề -->
    <div class="space-y-2">
      <h3 class="text-xs font-bold tracking-widest uppercase text-blue-600">TRƯỜNG THPT NGUYỄN DUY TRINH</h3>
      <h1 class="text-xl sm:text-2xl font-extrabold text-slate-800 leading-snug">
        Cổng Tra Cứu Thông Tin Tuyển Sinh & Lớp Học
      </h1>
      <p class="text-xs text-slate-500">
        Năm học 2026 - 2027
      </p>
    </div>

    <!-- Hướng dẫn cho người dùng quét QR từ Zalo/Facebook -->
    <div id="warningBox" class="hidden bg-amber-50 border border-amber-300 p-3.5 rounded-xl text-xs text-amber-900 text-left space-y-1">
      <p class="font-bold flex items-center gap-1">⚠️ Lưu ý quan trọng:</p>
      <p>Bạn đang mở bằng trình duyệt trong ứng dụng Zalo/Facebook. Để hệ thống chạy ổn định và không bị lỗi, vui lòng bấm vào nút bên dưới hoặc bấm <b>dấu 3 chấm (...)</b> góc trên bên phải chọn <b>"Mở bằng trình duyệt"</b>.</p>
    </div>

    <!-- Nút bấm chính mở Web App chính thức -->
    <div class="space-y-3 pt-2">
      <a id="btnOpen" href="https://script.google.com/macros/s/AKfycbzj6rztY08Y2JauWdurmGw1BMV98-MUnIznNFB1ffozX3PUAOEzUk5iKhiJnH3gXg-0/exec" target="_blank"
         class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg shadow-blue-600/30 transition transform active:scale-95 flex items-center justify-center gap-2 text-base">
        <span>🚀 Bấm vào đây để vào hệ thống</span>
      </a>
      
      <p class="text-[11px] text-slate-400">
        Hệ thống bảo mật bằng SBD và Số CCCD của học sinh.
      </p>
    </div>

  </div>

  <script>
    // Tự động phát hiện nếu người dùng đang mở bằng Zalo hoặc Facebook In-app Browser
    var ua = navigator.userAgent || navigator.vendor || window.opera;
    var isZalo = (ua.indexOf("Zalo") > -1);
    var isFB = (ua.indexOf("FBAV") > -1 || ua.indexOf("FBAN") > -1);

    if (isZalo || isFB) {
      document.getElementById('warningBox').classList.remove('hidden');
    }

    // (Tùy chọn) Bạn có thể thay dòng link ở thuộc tính href của thẻ a bên trên bằng link thực tế của bạn.
  </script>

</body>
</html>
