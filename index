  <script>
    document.addEventListener("DOMContentLoaded", function() {
      loadSchoolInfo();
    });

    function loadSchoolInfo() {
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler(function(config) {
            if (!config) return;

            const updateClassText = (className, val) => {
              if (val) {
                document.querySelectorAll('.' + className).forEach(el => el.innerText = val);
              }
            };

            updateClassText('info-ten-truong', config.TEN_TRUONG);
            updateClassText('info-cq-chu-quan', config.CQ_CHU_QUAN);
            updateClassText('info-nam-hoc', config.NAM_HOC_HIEN_TAI || config.NAM_HIEN_TAI);
            updateClassText('info-hieu-truong', config.TEN_HIEU_TRUONG);
          })
          .withFailureHandler(function(err) {
            console.error("Lỗi lấy cấu hình:", err);
          })
          .getSchoolInfo();
      }
    }

    // Hàm hỗ trợ chuẩn hóa ngày sinh hiển thị DD/MM/YYYY
    function formatDateVN(dateStr) {
      if (!dateStr) return "";
      var str = String(dateStr).trim();
      
      if (str.includes("T")) {
        str = str.split("T")[0];
      }
      
      if (str.includes("-")) {
        var parts = str.split("-");
        if (parts.length === 3 && parts[0].length === 4) {
          return parts[2] + "/" + parts[1] + "/" + parts[0];
        }
      }
      
      return str;
    }

    function handleSearch() {
      const kw = document.getElementById('searchInput').value.trim();
      const btn = document.getElementById('btnSearch');
      const btnText = document.getElementById('btnSearchText');
      const resultsDiv = document.getElementById('searchResults');
      const msgDiv = document.getElementById('searchMessage');
      const tbody = document.getElementById('tableBody');

      if (!kw) { alert('Vui lòng nhập SBD hoặc Họ tên!'); return; }

      btn.disabled = true;
      btnText.innerHTML = '<span class="loader"></span> Đang tìm...';

      google.script.run
        .withSuccessHandler(function(res) {
          btn.disabled = false;
          btnText.innerText = 'TRA CỨU';
          resultsDiv.classList.remove('hidden');

          if (res.success && res.data.length > 0) {
            msgDiv.innerText = `Tìm thấy ${res.data.length} kết quả:`;
            let html = '';
            res.data.forEach(item => {
              var ngaySinhFormatted = formatDateVN(item.ngaySinh);
              
              html += `<tr class="hover:bg-slate-50 transition">
                <td class="p-2.5 font-mono font-bold text-blue-900">${item.sbd}</td>
                <td class="p-2.5 font-bold uppercase text-slate-800">${item.hoTen}</td>
                <td class="p-2.5 text-slate-600 font-medium">${ngaySinhFormatted}</td>
                <td class="p-2.5 text-center font-bold text-amber-700">${item.tongDiem}</td>
                <td class="p-2.5 text-center"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded-full font-bold text-[10px]">${item.trangThai}</span></td>
              </tr>`;
            });
            tbody.innerHTML = html;
          } else {
            msgDiv.innerText = 'Không tìm thấy dữ liệu phù hợp!';
            tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400">Không có kết quả phù hợp với từ khóa "${kw}"</td></tr>`;
          }
        })
        .withFailureHandler(function(err) {
          btn.disabled = false;
          btnText.innerText = 'TRA CỨU';
          alert('Lỗi tra cứu: ' + err.message);
        })
        .searchTrungTuyen(kw);
    }
  </script>
